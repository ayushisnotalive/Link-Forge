RABBITMQ# ============================================
# LinkForge Environment Configuration
# Copy this file to .env and modify as needed
# ============================================

# PostgreSQL
POSTGRES_USER=linkforge
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=linkforge
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# RabbitMQ
RABBITMQ_USER=linkforge
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production

# URLs (internal Docker network)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672_URL=amqp://linkforge:linkforge_dev@localhost:5672

# JWT
JWT_SECRET=your_super_secret_jwt_secret_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d